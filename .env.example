# For a fresh local Docker demo run: bash scripts/setup-local.sh
# Never commit .env or use these placeholders on a public deployment.
DATABASE_PASSWORD=replace-with-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
CATALOG_API_KEY=replace-with-random-service-key
ADMIN_API_KEY=replace-with-random-admin-key
CORS_ORIGIN=http://localhost:8088
