@baseUrl = http://localhost:8080
@movieId = 2

### 0. Register fresh test user
POST {{baseUrl}}/users
Content-Type: application/json

{
  "name": "Denny Test",
  "email": "denny.favorite.test@example.com",
  "password": "secret123"
}
### 1. Login — JWT saved automatically
POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "email": "denny.favorite.test@example.com",
  "password": "secret123"
}

> {%
    client.test("login returns a JWT", function () {
        client.assert(response.status === 200, "Expected login to return HTTP 200");
        client.assert(response.body.token, "Expected response.body.token to contain a JWT");
    });

    client.global.set("auth_token", response.body.token);
    client.global.headers.set("Authorization", "Bearer " + response.body.token);
%}

### 2. Add movie to favorites
POST {{baseUrl}}/favorites/{{movieId}}

### 3. Get favorites — tests our new batch Catalog call
GET {{baseUrl}}/favorites

### 4. Remove favorite
DELETE {{baseUrl}}/favorites/{{movieId}}

### 5. Verify removal
GET {{baseUrl}}/favorites
