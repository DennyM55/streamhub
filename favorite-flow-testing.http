@baseUrl = http://localhost:8080
@movieId = 2

### 0. Register user — only needed once
POST {{baseUrl}}/users
Content-Type: application/json

{
  "name": "Denny Test",
  "email": "denny.favorite.test@example.com",
  "password": "secret123"
}

### 1. Login — RUN THIS FIRST
POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "email": "denny.favorite.test@example.com",
  "password": "secret123"
}

> {%
    client.test("login returns a JWT", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.token, "JWT missing");
    });

    client.global.set("auth_token", response.body.token);
%}

### 2. Add favorite
POST {{baseUrl}}/favorites/{{movieId}}
Authorization: Bearer {{auth_token}}

### 3. Get favorites
GET {{baseUrl}}/favorites
Authorization: Bearer {{auth_token}}

### 4. Remove favorite
DELETE {{baseUrl}}/favorites/{{movieId}}
Authorization: Bearer {{auth_token}}

### 5. Verify removal
GET {{baseUrl}}/favorites
Authorization: Bearer {{auth_token}}

### 6. Catalog DOWN test
# Stop catalog-service :8081 before running this.
# Expected: HTTP 503 "Catalog service unavailable"
GET {{baseUrl}}/favorites
Authorization: Bearer {{auth_token}}